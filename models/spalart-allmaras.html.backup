<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>Spalart-Allmaras - Beko CFD AI Agent</title>
    
    <!-- KaTeX for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"></script>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.6;
            color: #1e293b;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            min-height: 100vh;
            opacity: 0;
            animation: fadeInPage 0.6s ease-out forwards;
        }

        @keyframes fadeInPage {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1rem;
        }

        /* Header */
        .header {
            background: linear-gradient(135deg, rgba(139,92,246,0.06), rgba(196,181,253,0.03));
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(139,92,246,0.12);
            padding: 0.75rem 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: #3b82f6;
            text-decoration: none;
        }

        .nav-tabs {
            display: flex;
            gap: 0.5rem;
        }

        .nav-tab {
            padding: 0.5rem 1rem;
            text-decoration: none;
            color: #64748b;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .nav-tab:hover {
            background: rgba(59,130,246,0.1);
            color: #3b82f6;
        }

        .nav-tab.active {
            background: #3b82f6;
            color: white;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #3b82f6;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .back-link:hover {
            transform: translateX(-2px);
        }

        /* Main Content */
        .main-content {
            padding: 2rem 0;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            margin-bottom: 2rem;
            padding: 2rem;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            border: 1px solid rgba(139,92,246,0.1);
        }

        .model-icon {
            width: 4rem;
            height: 4rem;
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            color: white;
            border-radius: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 700;
            margin: 0 auto 1rem;
            box-shadow: 0 4px 6px -1px rgba(139,92,246,0.2);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: #8b5cf6;
            margin-bottom: 0.5rem;
        }

        .page-subtitle {
            font-size: 1.125rem;
            color: #64748b;
            font-weight: 500;
        }

        /* Content Tabs */
        .content-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            border-bottom: 2px solid rgba(139,92,246,0.1);
            padding-bottom: 0.5rem;
        }

        .content-tab {
            padding: 0.75rem 1.5rem;
            background: transparent;
            border: 2px solid rgba(139,92,246,0.2);
            border-radius: 0.75rem;
            color: #64748b;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

        .content-tab:hover {
            background: rgba(139,92,246,0.05);
            border-color: rgba(139,92,246,0.3);
            color: #8b5cf6;
        }

        .content-tab.active {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            border-color: #8b5cf6;
            color: white;
            box-shadow: 0 4px 15px rgba(139,92,246,0.3);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.3s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Industry Guide Styles */
        .industry-guide {
            max-width: none;
        }

        .guide-section {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(139,92,246,0.1);
        }

        .guide-section h3 {
            color: #1e293b;
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid rgba(139,92,246,0.1);
        }

        .guide-section h4 {
            color: #4f46e5;
            font-size: 1.1rem;
            font-weight: 600;
            margin: 1.5rem 0 0.75rem 0;
        }

        .guide-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .guide-item {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            padding: 0.5rem;
            border-radius: 0.5rem;
            transition: background 0.2s ease;
        }

        .guide-item:hover {
            background: rgba(139,92,246,0.03);
        }

        .guide-bullet {
            color: #8b5cf6;
            font-weight: bold;
            font-size: 1.1rem;
            margin-top: 0.1rem;
            flex-shrink: 0;
        }

        .guide-text {
            color: #4b5563;
            line-height: 1.6;
            flex: 1;
        }

        .guide-emphasis {
            color: #1e293b;
            font-weight: 600;
        }

        .use-case-item, .avoid-item {
            background: rgba(139,92,246,0.03);
            padding: 0.75rem;
            border-radius: 0.5rem;
            margin-bottom: 0.5rem;
            border-left: 3px solid #8b5cf6;
        }

        /* Academy Guide Styles */
        .academy-guide {
            max-width: none;
        }

        .theory-section {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            padding: 2rem;
            margin-bottom: 2rem;
            border: 1px solid rgba(139,92,246,0.15);
        }

        .theory-section h3 {
            color: #1e293b;
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 3px solid rgba(139,92,246,0.2);
        }

        .theory-section h4 {
            color: #4f46e5;
            font-size: 1.2rem;
            font-weight: 600;
            margin: 2rem 0 1rem 0;
        }

        .equation-container {
            background: linear-gradient(135deg, rgba(248,250,252,0.9), rgba(241,245,249,0.8));
            border: 2px solid rgba(139,92,246,0.15);
            border-radius: 0.75rem;
            padding: 1.5rem;
            margin: 1.5rem 0;
            text-align: center;
            box-shadow: 0 4px 15px rgba(139,92,246,0.05);
        }

        .equation-title {
            font-size: 1rem;
            font-weight: 700;
            color: #8b5cf6;
            margin-bottom: 1rem;
        }

        .math-block {
            font-size: 1.1rem;
            color: #1e293b;
            margin: 0.5rem 0;
        }

        .definition-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1rem;
            margin: 1.5rem 0;
        }

        .definition-item {
            background: rgba(139,92,246,0.05);
            padding: 1rem;
            border-radius: 0.75rem;
            border: 1px solid rgba(139,92,246,0.1);
        }

        .definition-term {
            font-weight: 700;
            color: #8b5cf6;
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }

        .definition-desc {
            color: #4b5563;
            line-height: 1.5;
            font-size: 0.9rem;
        }

        .physical-meaning {
            background: linear-gradient(135deg, rgba(16,185,129,0.05), rgba(5,150,105,0.03));
            border-left: 4px solid #10b981;
            padding: 1.5rem;
            border-radius: 0.5rem;
            margin: 1.5rem 0;
        }

        .physical-meaning h4 {
            color: #065f46;
            margin-bottom: 0.75rem;
        }

        /* Quick Decision Cards */
        .quick-decisions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .decision-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            padding: 1.5rem;
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }

        .decision-card.use-it {
            border-color: #10b981;
            box-shadow: 0 4px 20px rgba(16, 185, 129, 0.1);
        }

        .decision-card.avoid-it {
            border-color: #f59e0b;
            box-shadow: 0 4px 20px rgba(245, 158, 11, 0.1);
        }

        .decision-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .decision-icon {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 700;
        }

        .use-it .decision-icon {
            background: linear-gradient(135deg, #10b981, #34d399);
            color: white;
        }

        .avoid-it .decision-icon {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
            color: white;
        }

        .decision-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1e293b;
        }

        /* Content Sections */
        .content-section {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(139,92,246,0.1);
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid rgba(139,92,246,0.1);
        }

        .section-icon {
            width: 2rem;
            height: 2rem;
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            color: white;
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.875rem;
            font-weight: 700;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1e293b;
        }

        /* Highlight Boxes */
        .highlight-box {
            background: rgba(139,92,246,0.05);
            border-left: 4px solid #8b5cf6;
            padding: 1rem;
            border-radius: 0.5rem;
            margin: 1rem 0;
        }

        .highlight-box h4 {
            color: #8b5cf6;
            font-weight: 600;
            margin-bottom: 0.5rem;
            font-size: 1rem;
        }

        /* Equation Boxes */
        .equation-box {
            background: rgba(248, 250, 252, 0.9);
            border: 2px solid rgba(139,92,246,0.15);
            border-radius: 0.75rem;
            padding: 1.5rem;
            margin: 1rem 0;
            text-align: center;
        }

        .equation-title {
            font-size: 1rem;
            font-weight: 700;
            color: #8b5cf6;
            margin-bottom: 1rem;
        }

        /* Info Grid */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .info-item {
            background: rgba(139,92,246,0.05);
            padding: 1rem;
            border-radius: 0.75rem;
            border: 1px solid rgba(139,92,246,0.1);
        }

        .info-label {
            font-weight: 700;
            color: #8b5cf6;
            margin-bottom: 0.25rem;
            font-size: 0.875rem;
        }

        .info-value {
            font-size: 0.875rem;
            color: #64748b;
        }

        /* Comparison Table */
        .comparison-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
        }

        .comparison-table th,
        .comparison-table td {
            padding: 0.75rem;
            text-align: left;
            border-bottom: 1px solid rgba(139,92,246,0.1);
        }

        .comparison-table th {
            background: rgba(139,92,246,0.08);
            font-weight: 700;
            color: #8b5cf6;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .quick-decisions {
                grid-template-columns: 1fr;
            }
            
            .info-grid {
                grid-template-columns: 1fr;
            }
            
            .page-title {
                font-size: 2rem;
            }
        }

        /* Footer */
        .footer {
            text-align: center;
            padding: 2rem 0;
            color: #94a3b8;
            font-size: 0.75rem;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="header-content">
                <a href="../turbulence-models.html" class="logo">Beko CFD AI Agent</a>
                
                <!-- Navigation Tabs -->
                <div class="nav-tabs">
                    <a href="../home.html" class="nav-tab">🏠 Home</a>
                    <a href="../time-dependency.html" class="nav-tab">1. Time Dependency</a>
                    <a href="../turbulence-models.html" class="nav-tab active">2. Turbulence Models</a>
                    <a href="../methods.html" class="nav-tab">3. Methods</a>
                    <a href="../product-guide.html" class="nav-tab">Product Guide</a>
                </div>
            </div>
        </div>
    </header>

    <div class="container">
        <div class="main-content">
            <a href="../turbulence-models.html" class="back-link">
                ← Back to Turbulence Models
            </a>

            <!-- Page Header -->
            <div class="page-header">
                <div class="model-icon">S-A</div>
                <h1 class="page-title">Spalart-Allmaras</h1>
                <p class="page-subtitle">One-equation RANS model - Aerospace legacy model for external aerodynamics</p>
            </div>

            <!-- Content Tabs -->
            <div class="content-tabs">
                <button class="content-tab active" onclick="showTab('industry')">Industry Guide</button>
                <button class="content-tab" onclick="showTab('academy')">Academy Guide</button>
            </div>

            <!-- Industry Guide Tab Content -->
            <div id="industry" class="tab-content active">
            <div class="quick-decisions">
                <div class="decision-card use-it">
                    <div class="decision-header">
                        <div class="decision-icon">✅</div>
                        <div class="decision-title">Use Spalart-Allmaras When (Industry Focus)</div>
                    </div>
                    
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
                        <thead>
                            <tr style="background: rgba(16,185,129,0.1);">
                                <th style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.2); font-weight: 600; color: #065f46;">Situation</th>
                                <th style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.2); font-weight: 600; color: #065f46;">Why It Works</th>
                                <th style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.2); font-weight: 600; color: #065f46;">Advice</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);"><strong>External aerodynamics (aircraft, missiles)</strong></td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);">Designed specifically for aerospace applications</td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);">Legacy aerospace standard, well-validated</td>
                            </tr>
                            <tr>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);"><strong>Boundary layer flows (airfoils, wings)</strong></td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);">Excellent near-wall behavior, good separation</td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);">Good for attached and mildly separated flows</td>
                            </tr>
                            <tr>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);"><strong>Simple CFD codes (one equation advantage)</strong></td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);">Lower memory, simpler implementation</td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);">When computational simplicity matters</td>
                            </tr>
                            <tr>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);"><strong>Legacy aerospace codes (established workflows)</strong></td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);">Extensively validated in aerospace industry</td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(16,185,129,0.1);">Maintain compatibility with existing processes</td>
                            </tr>
                            <tr>
                                <td style="padding: 0.5rem;"><strong>Wall-bounded flows (channels, ducts)</strong></td>
                                <td style="padding: 0.5rem;">Good wall treatment, reasonable accuracy</td>
                                <td style="padding: 0.5rem;">Alternative to k-ω for wall-bounded flows</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="decision-card avoid-it">
                    <div class="decision-header">
                        <div class="decision-icon">⚠️</div>
                        <div class="decision-title">Avoid Spalart-Allmaras When (Industry Focus)</div>
                    </div>
                    
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
                        <thead>
                            <tr style="background: rgba(245,158,11,0.1);">
                                <th style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.2); font-weight: 600; color: #92400e;">Situation</th>
                                <th style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.2); font-weight: 600; color: #92400e;">Why It Fails</th>
                                <th style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.2); font-weight: 600; color: #92400e;">Industry Advice</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);"><strong>Modern aerospace projects (new designs)</strong></td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);">k-ω SST generally more accurate and versatile</td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);">Use k-ω SST for new aerospace projects</td>
                            </tr>
                            <tr>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);"><strong>Industrial flows (HVAC, pumps, process equipment)</strong></td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);">Not optimized for industrial applications</td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);">Use k-ε for industrial equipment</td>
                            </tr>
                            <tr>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);"><strong>Free shear flows (jets, mixing layers)</strong></td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);">Poor performance in free turbulence</td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);">Use k-ε or k-ω for free shear</td>
                            </tr>
                            <tr>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);"><strong>Complex 3D flows (automotive, turbomachinery)</strong></td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);">Limited physics compared to two-equation models</td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);">Use k-ω SST for complex 3D flows</td>
                            </tr>
                            <tr>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);"><strong>Heat transfer applications</strong></td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);">Lacks thermal modeling capabilities</td>
                                <td style="padding: 0.5rem; border-bottom: 1px solid rgba(245,158,11,0.1);">Use k-ε or k-ω for thermal analysis</td>
                            </tr>
                            <tr>
                                <td style="padding: 0.5rem;"><strong>Rotating flows (turbines, mixers)</strong></td>
                                <td style="padding: 0.5rem;">No rotation corrections built-in</td>
                                <td style="padding: 0.5rem;">Use RSM or rotation-corrected models</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Industry Takeaway -->
            <div class="content-section" style="background: linear-gradient(135deg, rgba(59,130,246,0.05), rgba(147,197,253,0.05)); border: 2px solid #3b82f6;">
                <div class="section-header">
                    <div class="section-icon">🔑</div>
                    <div class="section-title">Industry Takeaway</div>
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem;">
                    <div class="highlight-box" style="background: rgba(16,185,129,0.05); border-left: 4px solid #10b981;">
                        <h4 style="color: #065f46;">✅ Aerospace Legacy</h4>
                        <p>Use for legacy aerospace codes and established workflows - proven track record.</p>
                    </div>
                    
                    <div class="highlight-box" style="background: rgba(245,158,11,0.05); border-left: 4px solid #f59e0b;">
                        <h4 style="color: #92400e;">⚡ One Equation Simple</h4>
                        <p>Simpler than two-equation models but less versatile - k-ω SST usually better choice.</p>
                    </div>
                    
                    <div class="highlight-box" style="background: rgba(139,92,246,0.05); border-left: 4px solid #8b5cf6;">
                        <h4 style="color: #5b21b6;">🎯 Specific Domain</h4>
                        <p>Best for external aerodynamics - not recommended for industrial or automotive applications.</p>
                    </div>
                </div>
            </div>

